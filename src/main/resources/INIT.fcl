// 测试9: import
// ────────────────────────────────────────────
println("")
println("=== Test 9: import 跨文件函数复用 ===")

import "/system/app/lib1.fcl"
import "/system/app/lib2.fcl"

// 命名空间调用
lib1.greet("Alice")
lib2.greet("Bob")

r3 = lib1.add(5, 6)
println("  lib1.add(5,6) = " + r3 + "  (期望 11)")

// 短名调用（无冲突)
greet("World")

// ────────────────────────────────────────────
// 测试10: include
// ────────────────────────────────────────────
println("")
println("=== Test 10: include 代码插入 ===")

include "/system/app/lib_unique.fcl"
uniqueGreeting("Test")
ans = getAnswer()
println("  getAnswer() = " + ans + "  (期望 42)")

// ────────────────────────────────────────────
// 测试11: fork 进程创建
// ────────────────────────────────────────────
println("")
println("=== Test 11: fork 进程创建 ===")

forkResult = fork()
if (forkResult != 0) {
    println("  [父进程 PID=" + getPID() + "] fork 返回 " + forkResult + " (子 PID, 期望 >0)")
}
if (forkResult == 0) {
    println("  [子进程 PID=" + getPID() + "] fork 返回 0 (期望 0), 父 PID=" + getPPID())
}

// 等待一会儿让子进程输出
println("")
println("  --- 等待子进程输出完毕 ---")
waitPID(2)
println("  --- 子进程已结束 ---")

// ────────────────────────────────────────────
// 测试12: fork 变量隔离
// ────────────────────────────────────────────
println("")
println("=== Test 12: fork 变量独立 ===")

var_before = "parent_value"
println("  fork 前 var_before = " + var_before)

forkVar = fork()
if (forkVar != 0) {
    // 父进程修改变量不影响子进程
    var_before = "modified_by_parent"
    println("  [父] 修改 var_before = " + var_before)
}
if (forkVar == 0) {
    // 子进程看到的是 fork 前的值
    println("  [子] var_before = " + var_before + " (期望 parent_value)")
    println("  [子] fork = " + fork + " (期望 1)")
}

// ────────────────────────────────────────────
// 测试13: 系统函数
// ────────────────────────────────────────────
println("")
println("=== Test 13: 系统函数 ===")

println("  当前 PID = " + getPID())
ppid = getPPID()
println("  父 PID = " + ppid)

