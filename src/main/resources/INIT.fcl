// ────────────────────────────────────────────
// 测试1: 变量与基本运算
// ────────────────────────────────────────────
println("")
println("=== Test 1: 变量与基本运算 ===")

x = 42
println("  x = " + x + "  (期望 42)")

y = 3.14
println("  y = " + y + "  (期望 3.14)")

name = "CilExec"
println("  name = " + name + "  (期望 CilExec)")

sum = 10 + 20
println("  10 + 20 = " + sum + "  (期望 30)")

diff = 100 - 45
println("  100 - 45 = " + diff + "  (期望 55)")

product = 7 * 8
println("  7 * 8 = " + product + "  (期望 56)")

quotient = 81 / 9
println("  81 / 9 = " + quotient + "  (期望 9)")

mod = 17 % 5
println("  17 % 5 = " + mod + "  (期望 2)")

// ────────────────────────────────────────────
// 测试2: 字符串
// ────────────────────────────────────────────
println("")
println("=== Test 2: 字符串拼接与长度 ===")

greeting = "Hello" + " " + "World"
println("  \"" + greeting + "\"  (期望 Hello World)")

msg = "testing"
len = #msg
println("  #\"testing\" = " + len + "  (期望 7)")

mixed = "2" + 2
println("  \"2\" + 2 = " + mixed + "  (期望 22)")

// ────────────────────────────────────────────
// 测试3: 布尔与比较
// ────────────────────────────────────────────
println("")
println("=== Test 3: 布尔与比较运算 ===")

println("  10 > 5  = " + (10 > 5) + "  (期望 true)")
println("  3 > 8   = " + (3 > 8) + "  (期望 false)")
println("  5 <= 5  = " + (5 <= 5) + "  (期望 true)")
println("  10 == 10 = " + (10 == 10) + "  (期望 true)")
println("  10 != 20 = " + (10 != 20) + "  (期望 true)")

println("  true and false = " + (true and false) + "  (期望 false)")
println("  true or false  = " + (true or false) + "  (期望 true)")
println("  !true = " + (!true) + "  (期望 false)")
println("  !false = " + (!false) + "  (期望 true)")

// ────────────────────────────────────────────
// 测试4: if 条件判断
// ────────────────────────────────────────────
println("")
println("=== Test 4: if 条件判断 ===")

score = 85
grade = ""
if (score >= 90) {
    grade = "A"
}
if (score >= 80 and score < 90) {
    grade = "B"
}
if (score >= 70 and score < 80) {
    grade = "C"
}
println("  score=85, grade=" + grade + "  (期望 B)")

// 嵌套 if
outer = 5
inner = 3
result = ""
if (outer > 0) {
    if (inner > 0) {
        result = "both-positive"
    }
}
println("  嵌套if: " + result + "  (期望 both-positive)")

// ────────────────────────────────────────────
// 测试5: while 循环
// ────────────────────────────────────────────
println("")
println("=== Test 5: while 循环 ===")

count = 0
i = 0
while i < 5 {
    count = count + i
    i = i + 1
}
println("  累加 0..4 = " + count + "  (期望 10)")

// break 测试
sumBreak = 0
k = 0
while true {
    if (k >= 4) {
        break
    }
    sumBreak = sumBreak + k
    k = k + 1
}
println("  break 测试: sum 0..3 = " + sumBreak + "  (期望 6)")

