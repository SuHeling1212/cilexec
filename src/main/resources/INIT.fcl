# INIT Process - System initialization

# Create log file first
createFile("/user/local", "hello.log")

int counter = 0

while (counter < 3) {
    counter=counter+1
    append("/user/local/hello.log",counter)
}
while (counter < 6) {
    counter=counter+1
    append("/user/local/hello.log",counter)
}
