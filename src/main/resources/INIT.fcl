// ============================================================
// Cilexec 回归测试 — 验证所有核心功能
// ============================================================

println("═══════════════════════════════════════════")
println("  回归测试开始")
println("═══════════════════════════════════════════")

// ── Test 1: 变量与运算 ──
println("")
println("【1/8】变量与运算")
x = 42
y = 3.14
s1 = 10 + 20
d1 = 100 - 45
p1 = 7 * 8
q1 = 81 / 9
m1 = 17 % 5
println("  pass: 42, 3.14, 10+20=30, 100-45=55")
println("  pass: 7*8=56, 81/9=9, 17%5=2")

// ── Test 2: 字符串与布尔 ──
println("")
println("【2/8】字符串与布尔")
g = "Hello" + " " + "World"
println("  pass: " + g)
if (10 > 5) { println("  pass: 10>5=true") }
if (true and false) { println("  FAIL: true and false") }
if (!false) { println("  pass: !false=true") }

// ── Test 3: if 与 while ──
println("")
println("【3/8】控制流")
score = 85
grade = "X"
if (score >= 90) {
    grade = "A"
}
println("  after if1 grade=" + grade)
if (score >= 80 and score < 90) {
    grade = "B"
}
println("  after if2 grade=" + grade)
if (score >= 70 and score < 80) {
    grade = "C"
}
println("  after if3 grade=" + grade)
if (grade == "B") {
    println("  pass: score=85 grade=B")
}

count = 0
i = 0
while i < 5 {
    count = count + i
    i = i + 1
}
println("  pass: while 0..4=" + count)

// ── Test 4: 数组与 Map ──
println("")
println("【4/8】数组与Map")
arr = [1, 2, 3, 4, 5]
arr[1] = 99
if (arr[0] == 1 and arr[1] == 99 and #arr == 5) {
    println("  pass: array ok")
}
person = {"name": "Alice", "age": 30}
if (person["name"] == "Alice" and person["age"] == 30) {
    println("  pass: map ok")
}

// ── Test 5: 用户函数 ──
println("")
println("【5/8】用户函数")
func add2(a, b) {
    return a + b
}
r = add2(10, 20)
if (r == 30) { println("  pass: add2(10,20)=30") }

println("  跨 tick 赋值中...")
result = add2(100, 200)
if (result == 300) { println("  pass: add2(100,200)=300") }

// ── Test 6: import / include ──
println("")
println("【6/8】模块复用")
import "/system/app/lib1.fcl"
lib1.greet("回归测试")
r2 = lib1.add(7, 8)
if (r2 == 15) { println("  pass: lib1.add(7,8)=15") }

include "/system/app/lib_unique.fcl"
ans = getAnswer()
if (ans == 42) { println("  pass: getAnswer()=42") }

// ── Test 7: fork ──
println("")
println("【7/8】Fork 进程")
forkPid = fork()
if (forkPid != 0) {
    println("  pass: [父] fork=" + fork + " 子PID=" + forkPid)
}
if (forkPid == 0) {
    println("  pass: [子] fork=" + fork + " PPID=" + getPPID())
}

// ── Test 8: 系统函数 ──
println("")
println("【8/8】系统函数")
println("  PID=" + getPID())

println("")
println("═══════════════════════════════════════════")
println("  回归测试完成")
println("═══════════════════════════════════════════")

while true {}
