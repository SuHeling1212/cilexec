println("")
println("=== Test 6: 数组 ===")

arr = [1, 2, 3, 4, 5]
println("  arr[0] = " + arr[0] + "  (期望 1)")
println("  arr[2] = " + arr[2] + "  (期望 3)")
println("  #arr = " + (#arr) + "  (期望 5)")

arr[1] = 99
println("  arr[1] 改为 99 后: " + arr[1] + "  (期望 99)")

