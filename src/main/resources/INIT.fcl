result = webget("https://jsonplaceholder.typicode.com/todos/1")
println("webget result: " + result)

println("")
println("=== Test 7: network.httpGet ===")
result2 = network.httpGet("https://jsonplaceholder.typicode.com/posts/1")
println("httpGet result: " + result2)

println("")
println("=== Test 8: network.httpPost ===")
