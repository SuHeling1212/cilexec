// ═══════════════════════════════════════════════════════════════
// CilExec Shell — 交互式命令行终端
// PID 1 (INIT) 启动后进入 shell 循环
// ═══════════════════════════════════════════════════════════════

// ── 启动横幅 ──
println("")
println("╔═══════════════════════════════════════════════╗")
println("║     CilExec (CilExec) v1.0-SNAPSHOT         ║")
println("║      交互式命令行终端 — FCL Shell            ║")
println("╚═══════════════════════════════════════════════╝")
println("  输入 help 查看命令列表 · exit 退出")
println("")

// ── ── ── ── ── ── ── ── ── ── ── ── ── ── ── ── ── ──
// Shell 主循环
// ── ── ── ── ── ── ── ── ── ── ── ── ── ── ── ── ── ──
while (true) {
    println("")
    cmd = input("cil@local:~$ ")

    // ── 空输入 ──
    if (cmd == "") {
        continue
    }

    // ══════════════════════════════════════════════════
    // 无参数命令
    // ══════════════════════════════════════════════════

    if (cmd == "help") {
        shell_help()
        continue
    }

    if (cmd == "exit" or cmd == "quit") {
        println("  再见！")
        break
    }

    if (cmd == "clear") {
        shell_clear()
        continue
    }

    if (cmd == "whoami") {
        shell_whoami()
        continue
    }

    if (cmd == "pwd") {
        shell_pwd()
        continue
    }

    if (cmd == "pid") {
        shell_pid()
        continue
    }

    if (cmd == "ps") {
        shell_ps()
        continue
    }

    if (cmd == "users") {
        shell_users()
        continue
    }

    if (cmd == "env") {
        shell_env()
        continue
    }

    if (cmd == "swap") {
        shell_swap()
        continue
    }

    if (cmd == "time" or cmd == "uptime") {
        shell_time()
        continue
    }

    // ══════════════════════════════════════════════════
    // 带参数命令（分步输入参数）
    // ══════════════════════════════════════════════════

    if (cmd == "read" or cmd == "cat") {
        shell_read()
        continue
    }

    if (cmd == "write") {
        shell_write()
        continue
    }

    if (cmd == "append") {
        shell_append()
        continue
    }

    if (cmd == "ls") {
        shell_ls()
        continue
    }

    if (cmd == "mkdir") {
        shell_mkdir()
        continue
    }

    if (cmd == "create") {
        shell_create()
        continue
    }

    if (cmd == "rm") {
        shell_rm()
        continue
    }

    if (cmd == "rmdir") {
        shell_rmdir()
        continue
    }

    if (cmd == "link") {
        shell_link()
        continue
    }

    if (cmd == "lock") {
        shell_lock()
        continue
    }

    if (cmd == "unlock") {
        shell_unlock()
        continue
    }

    if (cmd == "meta") {
        shell_meta()
        continue
    }

    if (cmd == "fork") {
        shell_fork()
        continue
    }

    if (cmd == "exec") {
        shell_exec()
        continue
    }

    if (cmd == "kill") {
        shell_kill()
        continue
    }

    if (cmd == "wait") {
        shell_wait()
        continue
    }

    if (cmd == "pause") {
        shell_pause()
        continue
    }

    if (cmd == "continue") {
        shell_continue()
        continue
    }

    if (cmd == "switch") {
        shell_switch()
        continue
    }

    if (cmd == "createuser") {
        shell_createuser()
        continue
    }

    if (cmd == "removeuser") {
        shell_removeuser()
        continue
    }

    if (cmd == "httpget" or cmd == "webget") {
        shell_httpget()
        continue
    }

    if (cmd == "httppost" or cmd == "webpost") {
        shell_httppost()
        continue
    }

    if (cmd == "swapcreate") {
        shell_swapcreate()
        continue
    }

    if (cmd == "swapadd") {
        shell_swapadd()
        continue
    }

    if (cmd == "swapget") {
        shell_swapget()
        continue
    }

    if (cmd == "swaprm") {
        shell_swaprm()
        continue
    }

    if (cmd == "swapls") {
        shell_swapls()
        continue
    }

    if (cmd == "swapwait") {
        shell_swapwait()
        continue
    }

    if (cmd == "swapsignal") {
        shell_swapsignal()
        continue
    }

    // ══════════════════════════════════════════════════
    // 未知命令
    // ══════════════════════════════════════════════════

    println("  未知命令: " + cmd)
    println("  输入 help 查看可用命令列表")
}


// ══════════════════════════════════════════════════════════════
//  无参数命令处理函数
// ══════════════════════════════════════════════════════════════

func shell_help() {
    println("")
    println("  ─── CilExec Shell 命令列表 ───")
    println("")
    println("  [无参数命令]")
    println("    help      — 显示本帮助")
    println("    exit/quit — 退出 shell")
    println("    clear     — 清屏")
    println("    whoami    — 显示当前用户")
    println("    pwd       — 显示当前目录")
    println("    pid       — 显示当前 PID")
    println("    ps        — 列出所有子进程")
    println("    users     — 列出所有用户")
    println("    env       — 显示环境变量")
    println("    swap      — 列出所有交换池")
    println("    time/uptime — 系统运行状态")
    println("")
    println("  [文件操作 — 分步输入参数]")
    println("    read/cat  — 读取文件内容")
    println("    write     — 写入文件")
    println("    append    — 追加内容到文件")
    println("    ls        — 列出目录内容")
    println("    mkdir     — 创建目录")
    println("    create    — 创建空文件")
    println("    rm        — 删除文件")
    println("    rmdir     — 删除空目录")
    println("    link      — 创建符号链接")
    println("    lock      — 锁定文件")
    println("    unlock    — 解锁文件")
    println("    meta      — 查看文件元数据")
    println("")
    println("  [进程管理]")
    println("    fork      — 创建子进程")
    println("    exec      — 执行新程序")
    println("    kill      — 终止进程")
    println("    wait      — 等待子进程")
    println("    pause     — 暂停进程")
    println("    continue  — 继续进程")
    println("")
    println("  [用户管理]")
    println("    switch    — 切换用户")
    println("    createuser — 创建新用户")
    println("    removeuser — 删除用户")
    println("")
    println("  [网络]")
    println("    httpget/webget  — HTTP GET 请求")
    println("    httppost/webpost — HTTP POST 请求")
    println("")
    println("  [交换池 IPC]")
    println("    swapcreate — 创建交换池")
    println("    swapadd    — 添加变量到交换池")
    println("    swapget    — 从交换池获取变量")
    println("    swaprm     — 删除交换池变量")
    println("    swapls     — 列出交换池变量")
    println("    swapwait   — 等待交换池变量")
    println("    swapsignal — 发送交换池信号")
    println("")
    println("  提示: 输入命令名后按回车，再按提示输入参数")
}

func shell_clear() {
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
    println("")
}

func shell_whoami() {
    cur = getCurrentUser()
    println("  " + cur)
}

func shell_pwd() {
    println("  ~/  (/user/local/)")
}

func shell_pid() {
    println("  " + getPID())
}

func shell_ps() {
    info = getListOfChildProcess()
    println("  子进程:")
    println("  " + info)
}

func shell_users() {
    list = getListOfUsers()
    println("  " + list)
}

func shell_env() {
    home = path.getEnvVar("HOME")
    system = path.getEnvVar("SYSTEM")
    pathVar = path.getEnvVar("PATH")
    println("  HOME=" + home)
    println("  SYSTEM=" + system)
    println("  PATH=" + pathVar)
}

func shell_swap() {
    result = swapPool.list()
    println("  " + result)
}

func shell_time() {
    println("  系统已启动 · 使用 uptime 查看详细")
}


// ══════════════════════════════════════════════════════════════
//  文件操作命令
// ══════════════════════════════════════════════════════════════

func shell_read() {
    path = input("  文件路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    result = read(path)
    println("  " + result)
}

func shell_write() {
    path = input("  文件路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    content = input("  内容: ")
    write(path, content)
    println("  OK")
}

func shell_append() {
    path = input("  文件路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    content = input("  追加内容: ")
    append(path, content)
    println("  OK")
}

func shell_ls() {
    path = input("  目录路径 (~/): ")
    if (path == "") {
        path = "~/"
    }
    result = listdir(path)
    println("  " + result)
}

func shell_mkdir() {
    parent = input("  父目录: ")
    if (parent == "") {
        println("  ERROR: 父目录不能为空")
        return
    }
    name = input("  目录名: ")
    if (name == "") {
        println("  ERROR: 目录名不能为空")
        return
    }
    createDir(parent, name)
    println("  OK: " + parent + name + "/")
}

func shell_create() {
    parent = input("  父目录: ")
    if (parent == "") {
        println("  ERROR: 父目录不能为空")
        return
    }
    name = input("  文件名: ")
    if (name == "") {
        println("  ERROR: 文件名不能为空")
        return
    }
    createFile(parent, name)
    println("  OK: " + parent + name)
}

func shell_rm() {
    path = input("  文件路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    removeFile(path)
    println("  OK")
}

func shell_rmdir() {
    path = input("  目录路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    removeDir(path)
    println("  OK")
}

func shell_link() {
    dir = input("  目标目录: ")
    if (dir == "") {
        println("  ERROR: 目录不能为空")
        return
    }
    target = input("  链接目标路径: ")
    if (target == "") {
        println("  ERROR: 目标路径不能为空")
        return
    }
    link(dir, target)
    println("  OK")
}

func shell_lock() {
    path = input("  文件路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    lock(path)
    println("  OK")
}

func shell_unlock() {
    path = input("  文件路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    unlock(path)
    println("  OK")
}

func shell_meta() {
    path = input("  文件/目录路径: ")
    if (path == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    result = readMetaData(path)
    println("  " + result)
}


// ══════════════════════════════════════════════════════════════
//  进程管理命令
// ══════════════════════════════════════════════════════════════

func shell_fork() {
    println("  创建子进程...")
    childPid = fork()
    println("  子进程 PID: " + childPid)
}

func shell_exec() {
    script = input("  脚本路径: ")
    if (script == "") {
        println("  ERROR: 路径不能为空")
        return
    }
    args = input("  参数（逗号分隔）: ")
    exec(script, args)
}

func shell_kill() {
    pidStr = input("  目标 PID: ")
    if (pidStr == "") {
        println("  ERROR: PID 不能为空")
        return
    }
    kill(pidStr)
    println("  OK")
}

func shell_wait() {
    println("  等待子进程结束...")
    wait()
    println("  子进程已结束")
}

func shell_pause() {
    pidStr = input("  目标 PID: ")
    if (pidStr == "") {
        println("  ERROR: PID 不能为空")
        return
    }
    pause(pidStr)
    println("  OK")
}

func shell_continue() {
    pidStr = input("  目标 PID: ")
    if (pidStr == "") {
        println("  ERROR: PID 不能为空")
        return
    }
    continue(pidStr)
    println("  OK")
}


// ══════════════════════════════════════════════════════════════
//  用户管理命令
// ══════════════════════════════════════════════════════════════

func shell_switch() {
    user = input("  用户名: ")
    if (user == "") {
        println("  ERROR: 用户名不能为空")
        return
    }
    pass = input("  密码: ")
    switchUser(user, pass)
    println("  当前用户: " + getCurrentUser())
}

func shell_createuser() {
    user = input("  新用户名: ")
    if (user == "") {
        println("  ERROR: 用户名不能为空")
        return
    }
    pass = input("  密码: ")
    createUser(user, pass, false)
    println("  OK: 用户 " + user + " 已创建")
}

func shell_removeuser() {
    user = input("  用户名: ")
    if (user == "") {
        println("  ERROR: 用户名不能为空")
        return
    }
    pass = input("  密码: ")
    removeUser(user, pass)
    println("  OK")
}


// ══════════════════════════════════════════════════════════════
//  网络命令
// ══════════════════════════════════════════════════════════════

func shell_httpget() {
    url = input("  URL: ")
    if (url == "") {
        println("  ERROR: URL 不能为空")
        return
    }
    resp = httpGet(url)
    println("  " + resp)
}

func shell_httppost() {
    url = input("  URL: ")
    if (url == "") {
        println("  ERROR: URL 不能为空")
        return
    }
    data = input("  数据: ")
    resp = httpPost(url, data)
    println("  " + resp)
}


// ══════════════════════════════════════════════════════════════
//  交换池 IPC 命令
// ══════════════════════════════════════════════════════════════

func shell_swapcreate() {
    name = input("  交换池名称: ")
    if (name == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    swapPool.create(name)
    println("  OK: pool " + name)
}

func shell_swapadd() {
    pool = input("  交换池名称: ")
    if (pool == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    entry = input("  变量 (格式 key:value): ")
    swapPool.add(entry, pool)
    println("  OK")
}

func shell_swapget() {
    pool = input("  交换池名称: ")
    if (pool == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    key = input("  变量名: ")
    if (key == "") {
        println("  ERROR: 变量名不能为空")
        return
    }
    val = swapPool.get(key, pool)
    println("  " + val)
}

func shell_swaprm() {
    pool = input("  交换池名称: ")
    if (pool == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    key = input("  变量名: ")
    if (key == "") {
        println("  ERROR: 变量名不能为空")
        return
    }
    swapPool.removeVar(key, pool)
    println("  OK")
}

func shell_swapls() {
    pool = input("  交换池名称: ")
    if (pool == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    vars = swapPool.ls(pool)
    println("  " + vars)
}

func shell_swapwait() {
    pool = input("  交换池名称: ")
    if (pool == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    key = input("  变量名: ")
    if (key == "") {
        println("  ERROR: 变量名不能为空")
        return
    }
    swapPool.waitFor(key, pool)
    println("  收到信号")
}

func shell_swapsignal() {
    pool = input("  交换池名称: ")
    if (pool == "") {
        println("  ERROR: 名称不能为空")
        return
    }
    key = input("  变量名: ")
    if (key == "") {
        println("  ERROR: 变量名不能为空")
        return
    }
    swapPool.signal(key, pool)
    println("  OK")
}


// ── 进程保持存活（永不抵达这里，但保留作为安全兜底）──
while (true) {
    // shell 循环已通过 break 退出
}
