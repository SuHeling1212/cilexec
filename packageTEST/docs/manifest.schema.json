{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cilexec.local/schema/package-manifest-v1.json",
  "title": "Cilexec package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "namespace",
    "name",
    "version",
    "entry",
    "exports",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "$ref": "#/$defs/fclPath"
    },
    "exports": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "symbol"
        ],
        "properties": {
          "module": {
            "$ref": "#/$defs/fclPath"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preInstall": {
          "$ref": "#/$defs/hook"
        },
        "postInstall": {
          "$ref": "#/$defs/hook"
        },
        "preUninstall": {
          "$ref": "#/$defs/hook"
        },
        "postUninstall": {
          "$ref": "#/$defs/hook"
        }
      }
    },
    "resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/packagePath"
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fclPath": {
      "allOf": [
        {
          "$ref": "#/$defs/packagePath"
        },
        {
          "pattern": "\\.fcl$"
        }
      ]
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "timeoutMs"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/fclPath"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "namespace",
        "name",
        "version",
        "integrity"
      ],
      "properties": {
        "binding": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
