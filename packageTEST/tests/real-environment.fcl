// Real Cilexec package-manager E2E scenario. This file is executed by the scheduler.
user.removeUser("fclreal", "fclreal-password")
createdUser = user.createUser("fclreal", "fclreal-password")
switchedUser = user.switchUser("fclreal", "fclreal-password")

file.createDir("/user/fclreal/app", "e2e")
file.createDir("/user/fclreal/app/e2e", "repo")
file.createDir("/user/fclreal/app/e2e", "dependency-v1")
file.createDir("/user/fclreal/app/e2e/dependency-v1", "payload")
file.createDir("/user/fclreal/app/e2e", "dependency-v2")
file.createDir("/user/fclreal/app/e2e/dependency-v2", "payload")
file.createDir("/user/fclreal/app/e2e", "root-v1")
file.createDir("/user/fclreal/app/e2e/root-v1", "payload")
file.createDir("/user/fclreal/app/e2e/root-v1", "resources")
file.createDir("/user/fclreal/app/e2e/root-v1", "hooks")
file.createDir("/user/fclreal/app/e2e", "root-v2")
file.createDir("/user/fclreal/app/e2e/root-v2", "payload")

dependencyManifestV1 = "{\"schemaVersion\":1,\"namespace\":\"e2e.real\",\"name\":\"dependency\",\"version\":\"1.0.0\",\"entry\":\"payload/main.fcl\",\"exports\":{\"depValue\":{\"module\":\"payload/main.fcl\",\"symbol\":\"depValue\"}},\"dependencies\":[]}"
dependencyManifestV2 = "{\"schemaVersion\":1,\"namespace\":\"e2e.real\",\"name\":\"dependency\",\"version\":\"2.0.0\",\"entry\":\"payload/main.fcl\",\"exports\":{\"depValue\":{\"module\":\"payload/main.fcl\",\"symbol\":\"depValue\"}},\"dependencies\":[]}"
io.writeFile("/user/fclreal/app/e2e/dependency-v1/manifest.json", dependencyManifestV1)
io.writeFile("/user/fclreal/app/e2e/dependency-v1/payload/main.fcl", "func depValue() { return 101 }")
io.writeFile("/user/fclreal/app/e2e/dependency-v2/manifest.json", dependencyManifestV2)
io.writeFile("/user/fclreal/app/e2e/dependency-v2/payload/main.fcl", "func depValue() { return 202 }")

dependencyBuildV1 = package.build("/user/fclreal/app/e2e/dependency-v1", "/user/fclreal/app/e2e/repo/dependency-v1.pack")
dependencyBuildV2 = package.build("/user/fclreal/app/e2e/dependency-v2", "/user/fclreal/app/e2e/repo/dependency-v2.pack")

rootManifestV1 = "{\"schemaVersion\":1,\"namespace\":\"e2e.real\",\"name\":\"root\",\"version\":\"1.0.0\",\"entry\":\"payload/main.fcl\",\"exports\":{\"rootValue\":{\"module\":\"payload/main.fcl\",\"symbol\":\"rootValue\"}},\"dependencies\":[{\"binding\":\"dep\",\"namespace\":\"e2e.real\",\"name\":\"dependency\",\"version\":\"1.0.0\",\"integrity\":\"" + dependencyBuildV1["integrity"] + "\"}],\"lifecycle\":{\"preInstall\":{\"script\":\"hooks/pre-install.fcl\",\"timeoutMs\":5000},\"postInstall\":{\"script\":\"hooks/post-install.fcl\",\"timeoutMs\":5000},\"preUninstall\":{\"script\":\"hooks/pre-uninstall.fcl\",\"timeoutMs\":5000},\"postUninstall\":{\"script\":\"hooks/post-uninstall.fcl\",\"timeoutMs\":5000}},\"resources\":[\"resources/config.json\"]}"
rootManifestV2 = "{\"schemaVersion\":1,\"namespace\":\"e2e.real\",\"name\":\"root\",\"version\":\"2.0.0\",\"entry\":\"payload/main.fcl\",\"exports\":{\"rootValue\":{\"module\":\"payload/main.fcl\",\"symbol\":\"rootValue\"}},\"dependencies\":[{\"binding\":\"dep\",\"namespace\":\"e2e.real\",\"name\":\"dependency\",\"version\":\"2.0.0\",\"integrity\":\"" + dependencyBuildV2["integrity"] + "\"}]}"
io.writeFile("/user/fclreal/app/e2e/root-v1/manifest.json", rootManifestV1)
io.writeFile("/user/fclreal/app/e2e/root-v1/payload/main.fcl", "import dep.*\nfunc rootValue() { value = depValue(); return value }")
io.writeFile("/user/fclreal/app/e2e/root-v1/resources/config.json", "{\"mode\":\"v1\"}")
io.writeFile("/user/fclreal/app/e2e/root-v1/hooks/pre-install.fcl", "hookResult = {\"status\":\"ok\",\"allow\":true}")
io.writeFile("/user/fclreal/app/e2e/root-v1/hooks/post-install.fcl", "hookResult = {\"status\":\"ok\"}")
io.writeFile("/user/fclreal/app/e2e/root-v1/hooks/pre-uninstall.fcl", "hookResult = {\"status\":\"ok\",\"allow\":true}")
io.writeFile("/user/fclreal/app/e2e/root-v1/hooks/post-uninstall.fcl", "hookResult = {\"status\":\"ok\"}")
io.writeFile("/user/fclreal/app/e2e/root-v2/manifest.json", rootManifestV2)
io.writeFile("/user/fclreal/app/e2e/root-v2/payload/main.fcl", "import dep.*\nfunc rootValue() { value = depValue(); return value }")

rootBuildV1 = package.build("/user/fclreal/app/e2e/root-v1", "/user/fclreal/app/e2e/repo/root-v1.pack")
rootBuildV2 = package.build("/user/fclreal/app/e2e/root-v2", "/user/fclreal/app/e2e/repo/root-v2.pack")
installedV1 = package.install("/user/fclreal/app/e2e/repo/root-v1.pack", "root-v1", "/user/fclreal/app/e2e/repo")
installedV2 = package.install("/user/fclreal/app/e2e/repo/root-v2.pack", "root-v2", "/user/fclreal/app/e2e/repo")

import root-v1.* as versionOne
import root-v2.* as versionTwo

one = versionOne.rootValue()
two = versionTwo.rootValue()
verifiedV1 = package.verify("root-v1")
verifiedV2 = package.verify("root-v2")
listed = package.list()
infoV1 = package.info("root-v1")
resourceV1 = package.resource("root-v1", "resources/config.json")
pinnedV1 = package.pin("root-v1")
unpinnedV1 = package.unpin("root-v1")
removedV1 = package.remove("root-v1")
removedV2 = package.remove("root-v2")
packageUser = user.getCurrentUser()
user.switchUser("local", "local")
recovered = package.recover()
garbageCollected = package.gc()
passed = one == 101 and two == 202 and verifiedV1["ok"] == true and verifiedV2["ok"] == true and util.isArray(listed) and infoV1["manifest"]["version"] == "1.0.0" and resourceV1 == "{\"mode\":\"v1\"}" and util.isMap(pinnedV1) and unpinnedV1 == true and removedV1["status"] == "removed" and removedV2["status"] == "removed" and recovered == "Package recovery completed" and garbageCollected["status"] == "collected"
result = {"case": "package", "passed": passed, "one": one, "two": two, "packageUser": packageUser, "installedV1": installedV1, "installedV2": installedV2, "verifiedV1": verifiedV1, "verifiedV2": verifiedV2, "listed": listed, "infoV1": infoV1, "resourceV1": resourceV1, "pinnedV1": pinnedV1, "removedV1": removedV1, "removedV2": removedV2, "recovered": recovered, "garbageCollected": garbageCollected}
io.writeFile("/user/fclreal/app/e2e/result.json", util.toJson(result))
io.println("FCL_REAL_E2E:" + util.toJson(result))
