file.createDir("/user/local/app/data", "fcl-tests")
base = "/user/local/app/data/fcl-tests"
getOne = network.httpGet("http://127.0.0.1:18765/get")
getTwo = network.webget("http://127.0.0.1:18765/get")
postOne = network.httpPost("http://127.0.0.1:18765/post", "{\"value\":1}")
postTwo = network.webpost("http://127.0.0.1:18765/post", "{\"value\":2}")
passed = getOne == "Response Code: 200\nfcl-get-ok" and getTwo == "Response Code: 200\nfcl-get-ok" and postOne == "Response Code: 200\nfcl-post:{\"value\":1}" and postTwo == "Response Code: 200\nfcl-post:{\"value\":2}"
result = {"case": "network", "passed": passed, "get": getOne, "post": postOne}
io.writeFile(base + "/network-result.json", util.toJson(result))
io.println("FCL_FULL_NETWORK:" + util.toJson(result))
