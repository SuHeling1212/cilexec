file.createDir("/user/local/app/data", "fcl-tests")
base = "/user/local/app/data/fcl-tests"
port = 18766
bound = socket.bind(port)
child = process.fork()
if child == 0 {
    util.sleep(50)
    client = socket.connect("127.0.0.1", port)
    clientSent = socket.send(client, "ping")
    reply = socket.receive(client)
    clientClosed = socket.close(client)
    io.writeFile(base + "/socket-child.txt", reply)
    util.exit()
}
accepted = socket.accept(port)
received = socket.receive(accepted)
serverSent = socket.send(accepted, "pong")
serverClosed = socket.close(accepted)
process.waitPID(child)
childReply = io.readFile(base + "/socket-child.txt")
passed = bound == "Bound to port 18766" and received == "ping" and childReply == "pong" and util.isString(serverSent) and serverClosed == "Connection closed"
result = {"case": "socket", "passed": passed, "bound": bound, "received": received, "reply": childReply, "accepted": accepted}
io.writeFile(base + "/socket-result.json", util.toJson(result))
io.println("FCL_FULL_SOCKET:" + util.toJson(result))
