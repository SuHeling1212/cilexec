file.createDir("/user/local/app/data", "fcl-tests")
base = "/user/local/app/data/fcl-tests"
self = process.getPID()
parent = process.getPPID()

pauseChild = process.fork()
if pauseChild == 0 {
    io.writeFile(base + "/pause-child.txt", "started")
    util.sleep(100)
    io.writeFile(base + "/pause-child.txt", "continued")
    util.exit()
}
children = process.getListOfChildProcess()
process.pause(pauseChild)
util.sleep(20)
process.continue(pauseChild)
process.waitPID(pauseChild)
pauseResult = io.readFile(base + "/pause-child.txt")

waitChild = process.fork()
if waitChild == 0 {
    io.writeFile(base + "/wait-child.txt", "waited")
    util.exit()
}
process.wait()
waitResult = io.readFile(base + "/wait-child.txt")

killChild = process.fork()
if killChild == 0 {
    counter = 0
    while true {
        counter = counter + 1
    }
}
util.sleep(30)
process.kill(killChild)
process.waitPID(killChild)

passed = self == 1 and parent == 0 and util.isString(children) and pauseResult == "continued" and waitResult == "waited" and killChild > 1
result = {"case": "process", "passed": passed, "self": self, "parent": parent, "pauseChild": pauseChild, "waitChild": waitChild, "killChild": killChild, "pauseResult": pauseResult, "waitResult": waitResult}
io.writeFile(base + "/process-result.json", util.toJson(result))
io.println("FCL_FULL_PROCESS:" + util.toJson(result))
