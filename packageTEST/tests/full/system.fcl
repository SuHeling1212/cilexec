file.createDir("/user/local/app/data", "fcl-tests")
base = "/user/local/app/data/fcl-tests"
hostListing = system.ls("/user/local/app")
invokedTime = system.invoke("java.lang.System", "currentTimeMillis")
hostExec = system.exec("printf fcl-system")
file.createDir(base, "force-remove")
io.writeFile(base + "/force-remove/value.txt", "remove-me")
forceRemoved = system.forceRemove(base + "/force-remove")
resolvedMissing = system.resolveEffect(99999, "missing-effect", "retry", null)

killChild = process.fork()
if killChild == 0 {
    while true {
        value = 1
    }
}
util.sleep(30)
systemKilled = system.kill(killChild)
process.waitPID(killChild)

passed = util.isString(hostListing) and util.isNumber(invokedTime) and hostExec == "Exit: 0\nfcl-system" and file.exists(base + "/force-remove") == false and resolvedMissing == false and systemKilled == "Killed PID " + killChild
result = {"case": "system", "passed": passed, "invoke": invokedTime, "exec": hostExec, "forceRemove": forceRemoved, "resolveMissing": resolvedMissing, "kill": systemKilled}
io.writeFile(base + "/system-result.json", util.toJson(result))
io.println("FCL_FULL_SYSTEM:" + util.toJson(result))
