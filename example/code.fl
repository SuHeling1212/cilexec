// 导入
import "math.fl"
import "io/file.fl"

// 变量类型
int a = 1
string b = "hello"
array c = [1,2,3,4,5]
map d = {"name":"follarce", "age":18}

// 运算
a = 1 + 2 * 3 / 4 % 5
b = a == b
c = a != b
d = a and b or not c

// 数组操作
arr = [1,2,3,4,5]
first = arr[0]      // 1
last = arr[-1]      // 5
len = #arr          // 5

// 控制流
if a > b {
    print("a > b")
} else {
    print("a <= b")
}

i = 0
while i < 10 {
    print(i)
    i = i + 1
}
// 没有for，但while够用

// 函数
func add(a, b) {
    return a + b
}

result = add(1, 2)


