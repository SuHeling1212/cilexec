// Pure, package-private full-frame renderer. It is copied into the installed package's
// private data space the first time CilEdit needs a complete normal-mode redraw, then run
// through process.run. It deliberately has no file, package, terminal-input, or output calls.

func wr_min(a, b) {
    if a < b { return a }
    return b
}

func wr_max(a, b) {
    if a > b { return a }
    return b
}

func wr_fit(value, width) {
    visible = term.sanitize(value)
    visible = term.truncate(visible, width)
    return visible + text.repeat(" ", width - term.displayWidth(visible))
}

func wr_body_height(state) {
    if state["height"] > 3 { return state["height"] - 3 }
    return 1
}

func wr_line(state, lineIndex) {
    line = state["lines"][lineIndex]
    start = wr_min(state["left"], #line)
    return wr_fit(text.slice(line, start), state["width"])
}

func wr_title(state) {
    title = " CilEdit  " + state["path"]
    if state["dirty"] { title = title + "  [Modified]" }
    return term.inverse(wr_fit(title, state["width"]))
}

func wr_status(state) {
    return " line " + util.toString(state["row"] + 1) + "/" + util.toString(#state["lines"])
        + "  col " + util.toString(state["col"] + 1)
}

func wr_cursor(state) {
    height = wr_body_height(state)
    cursorRow = state["row"] - state["top"] + 2
    line = state["lines"][state["row"]]
    cursorText = text.slice(line, state["left"], state["col"])
    cursorCol = term.displayWidth(term.sanitize(cursorText)) + 1
    return term.cursorTo(cursorRow, cursorCol) + term.showCursor()
}

state = process.arg(0)
width = wr_max(1, state["width"])
height = wr_body_height(state)
screen = term.hideCursor() + term.clear() + wr_title(state) + "\r\n"
visibleRow = 0
available = wr_min(height, #state["lines"] - state["top"])
while visibleRow < available {
    screen = screen + wr_line(state, state["top"] + visibleRow) + "\r\n"
    visibleRow++
}
remaining = height - visibleRow
if remaining > 0 {
    screen = screen + text.repeat(wr_fit("~", width) + "\r\n", remaining)
}
screen = screen + term.inverse(wr_fit(wr_status(state), width)) + "\r\n"
screen = screen + wr_fit("^O Save  ^X Exit  ^W Search  ^K Cut  ^U Paste  ^G Help", width)
return screen + wr_cursor(state)
