// CilEdit: the full-screen editor distributed through the CilExec package market.

func ed_min(a, b) {
    if a < b { return a }
    return b
}

func ed_max(a, b) {
    if a > b { return a }
    return b
}

func ed_fit(value, width) {
    visible = term.sanitize(value)
    visible = term.truncate(visible, width)
    return visible + text.repeat(" ", width - term.displayWidth(visible))
}

// The size is sampled at every layout/render pass. A low-rate input timeout checks
// for resize without continuously repainting an unchanged screen.
func ed_width() {
    size = term.getSize()
    return ed_max(1, size["width"])
}

func ed_body_height() {
    size = term.getSize()
    // title + status + footer consume three terminal rows.
    return ed_max(1, size["height"] - 3)
}

func ed_path(editorPath) {
    safePath = term.sanitize(editorPath)
    if path.isAbsolute(safePath) { return path.normalize(safePath) }
    return path.join(env.get("PWD"), safePath)
}

func ed_segment_width(line, start, end) {
    return term.displayWidth(term.sanitize(text.slice(line, start, end)))
}

func ed_fix(state) {
    lines = state["lines"]
    if state["row"] < 0 { state["row"] = 0 }
    if state["row"] >= #lines { state["row"] = #lines - 1 }
    width = ed_width()
    height = ed_body_height()
    line = lines[state["row"]]
    if state["col"] < 0 { state["col"] = 0 }
    if state["col"] > #line { state["col"] = #line }
    if state["row"] < state["top"] { state["top"] = state["row"] }
    if state["row"] >= state["top"] + height {
        state["top"] = state["row"] - height + 1
    }
    if state["col"] < state["left"] { state["left"] = state["col"] }
    if state["left"] < state["col"] and ed_segment_width(line, state["left"], state["col"]) >= width {
        // Keep a right-side margin so horizontal scrolling happens in chunks instead
        // of rebuilding the frame after every character beyond the terminal edge.
        margin = ed_min(16, ed_max(1, width - 1))
        state["left"] = ed_min(state["col"], state["left"] + margin)
        while state["left"] < state["col"] and ed_segment_width(line, state["left"], state["col"]) >= width {
            state["left"] = state["left"] + 1
        }
    }
    if state["top"] < 0 { state["top"] = 0 }
    if state["left"] < 0 { state["left"] = 0 }
    return state
}

func ed_insert(state, value) {
    row = state["row"]
    col = state["col"]
    line = state["lines"][row]
    state["lines"][row] = text.slice(line, 0, col) + value + text.slice(line, col)
    state["col"] = col + #value
    state["dirty"] = true
    state["message"] = ""
    return ed_fix(state)
}

func ed_enter(state) {
    row = state["row"]
    col = state["col"]
    lines = state["lines"]
    line = lines[row]
    lines[row] = text.slice(line, 0, col)
    state["lines"] = array.insert(lines, row + 1, text.slice(line, col))
    state["row"] = row + 1
    state["col"] = 0
    state["dirty"] = true
    state["message"] = ""
    return ed_fix(state)
}

func ed_remove_row(lines, row) {
    if #lines == 1 { return [""] }
    return array.removeAt(lines, row)
}

func ed_backspace(state) {
    row = state["row"]
    col = state["col"]
    lines = state["lines"]
    if col > 0 {
        line = lines[row]
        lines[row] = text.slice(line, 0, col - 1) + text.slice(line, col)
        state["col"] = col - 1
        state["lines"] = lines
        state["dirty"] = true
    } else {
        if row > 0 {
            previous = lines[row - 1]
            lines[row - 1] = previous + lines[row]
            state["lines"] = ed_remove_row(lines, row)
            state["row"] = row - 1
            state["col"] = #previous
            state["dirty"] = true
        }
    }
    state["message"] = ""
    return ed_fix(state)
}

func ed_delete(state) {
    row = state["row"]
    col = state["col"]
    lines = state["lines"]
    line = lines[row]
    if col < #line {
        lines[row] = text.slice(line, 0, col) + text.slice(line, col + 1)
        state["lines"] = lines
        state["dirty"] = true
    } else {
        if row + 1 < #lines {
            lines[row] = line + lines[row + 1]
            state["lines"] = ed_remove_row(lines, row + 1)
            state["dirty"] = true
        }
    }
    state["message"] = ""
    return ed_fix(state)
}

func ed_cut(state) {
    row = state["row"]
    state["clipboard"] = state["lines"][row]
    state["lines"] = ed_remove_row(state["lines"], row)
    if state["row"] >= #state["lines"] { state["row"] = #state["lines"] - 1 }
    state["col"] = 0
    state["dirty"] = true
    state["message"] = "Cut one line"
    return ed_fix(state)
}

func ed_save(state) {
    content = text.join(state["lines"], "\n")
    file.write(state["path"], content)
    state["dirty"] = false
    state["message"] = "Wrote " + util.toString(#state["lines"]) + " lines"
    return state
}

func ed_search(state) {
    query = state["query"]
    if #query == 0 {
        state["message"] = "Search cancelled"
        state["mode"] = "normal"
        return state
    }
    lines = state["lines"]
    startRow = state["row"]
    row = startRow
    from = state["col"] + 1
    visited = 0
    while visited < #lines {
        found = text.indexOf(lines[row], query, ed_min(from, #lines[row]))
        if found >= 0 {
            state["row"] = row
            state["col"] = found
            state["mode"] = "normal"
            state["message"] = "Found: " + query
            return ed_fix(state)
        }
        row = row + 1
        if row >= #lines { row = 0 }
        from = 0
        visited = visited + 1
    }
    state["mode"] = "normal"
    state["message"] = "Not found: " + query
    return state
}

func ed_prompt_key(state, event) {
    key = event["key"]
    mode = state["mode"]
    if mode == "help" {
        state["mode"] = "normal"
        state["message"] = ""
        return state
    }
    if mode == "exit" {
        if key == "y" or key == "Y" {
            state = ed_save(state)
            state["running"] = false
        } else {
            if key == "n" or key == "N" {
                state["running"] = false
            } else {
                if key == "CTRL_C" or key == "ESCAPE" {
                    state["mode"] = "normal"
                    state["message"] = "Exit cancelled"
                }
            }
        }
        return state
    }
    if mode == "search" {
        if key == "ENTER" {
            return ed_search(state)
        }
        if key == "CTRL_C" or key == "ESCAPE" {
            state["mode"] = "normal"
            state["message"] = "Search cancelled"
            return state
        }
        if key == "BACKSPACE" {
            if #state["query"] > 0 {
                state["query"] = text.slice(state["query"], 0, #state["query"] - 1)
            }
            return state
        }
        if #key == 1 { state["query"] = state["query"] + key }
        return state
    }
    return state
}

func ed_key(state, event) {
    kind = event["kind"]
    if kind == "mouse" {
        if event["action"] == "SCROLL" {
            state["top"] = state["top"] - event["scroll"]
            if state["top"] < 0 { state["top"] = 0 }
            return ed_fix(state)
        }
        return state
    }
    if kind == "paste" {
        if #event["text"] > 0 { return ed_insert(state, event["text"]) }
        return state
    }
    if kind != "key" { return state }
    key = event["key"]
    if state["mode"] != "normal" { return ed_prompt_key(state, event) }
    lines = state["lines"]
    row = state["row"]
    col = state["col"]
    if key == "CTRL_S" or key == "CTRL_O" { return ed_save(state) }
    if key == "CTRL_X" {
        if state["dirty"] {
            state["mode"] = "exit"
        } else {
            state["running"] = false
        }
        return state
    }
    if key == "CTRL_W" {
        state["mode"] = "search"
        state["query"] = ""
        return state
    }
    if key == "CTRL_G" {
        state["mode"] = "help"
        return state
    }
    if key == "CTRL_K" { return ed_cut(state) }
    if key == "CTRL_U" {
        if #state["clipboard"] > 0 { return ed_insert(state, state["clipboard"]) }
        state["message"] = "Clipboard is empty"
        return state
    }
    if key == "UP" {
        if row > 0 { state["row"] = row - 1 }
        return ed_fix(state)
    }
    if key == "DOWN" {
        if row + 1 < #lines { state["row"] = row + 1 }
        return ed_fix(state)
    }
    if key == "LEFT" {
        if col > 0 {
            state["col"] = col - 1
        } else {
            if row > 0 {
                state["row"] = row - 1
                state["col"] = #lines[row - 1]
            }
        }
        return ed_fix(state)
    }
    if key == "RIGHT" {
        if col < #lines[row] {
            state["col"] = col + 1
        } else {
            if row + 1 < #lines {
                state["row"] = row + 1
                state["col"] = 0
            }
        }
        return ed_fix(state)
    }
    if key == "HOME" {
        state["col"] = 0
        return ed_fix(state)
    }
    if key == "END" {
        state["col"] = #lines[row]
        return ed_fix(state)
    }
    if key == "PAGE_UP" {
        state["row"] = ed_max(0, row - ed_body_height())
        return ed_fix(state)
    }
    if key == "PAGE_DOWN" {
        state["row"] = ed_min(#lines - 1, row + ed_body_height())
        return ed_fix(state)
    }
    if key == "BACKSPACE" { return ed_backspace(state) }
    if key == "DELETE" { return ed_delete(state) }
    if key == "ENTER" { return ed_enter(state) }
    if key == "TAB" { return ed_insert(state, "    ") }
    if kind == "key" and #event["text"] > 0 { return ed_insert(state, event["text"]) }
    return state
}

func ed_frame_row(value, width, inverse) {
    return {text: ed_fit(value, width), inverse: inverse}
}

func ed_frame_help(state) {
    width = ed_width()
    height = ed_body_height()
    frameHeight = height + 3
    help = [
        "Ctrl-O / Ctrl-S  Save file",
        "Ctrl-X  Exit (asks before discarding changes)",
        "Ctrl-W  Search forward",
        "Ctrl-K  Cut current line; Ctrl-U Paste cut line",
        "Arrows, Home, End, PageUp, PageDown move",
        "Backspace, Delete, Enter and Tab edit",
        "",
        "Press any key to return"
    ]
    rows = [ed_frame_row(" CilEdit Help", width, true)]
    index = 0
    while #rows < frameHeight {
        value = ""
        if index < #help { value = help[index] }
        rows = array.insert(rows, #rows, ed_frame_row(value, width, false))
        index = index + 1
    }
    return {
        width: width,
        height: frameHeight,
        rows: rows,
        cursorRow: 1,
        cursorCol: 1,
        cursorVisible: false
    }
}

func ed_frame(state) {
    if state["mode"] == "help" { return ed_frame_help(state) }
    width = ed_width()
    height = ed_body_height()
    title = " CilEdit  " + state["path"]
    if state["dirty"] { title = title + "  [Modified]" }
    rows = [ed_frame_row(title, width, true)]
    visibleRow = 0
    available = ed_min(height, #state["lines"] - state["top"])
    while visibleRow < available {
        lineIndex = state["top"] + visibleRow
        line = state["lines"][lineIndex]
        start = ed_min(state["left"], #line)
        rows = array.insert(rows, #rows, ed_frame_row(text.slice(line, start), width, false))
        visibleRow = visibleRow + 1
    }
    while visibleRow < height {
        rows = array.insert(rows, #rows, ed_frame_row("~", width, false))
        visibleRow = visibleRow + 1
    }
    status = " line " + util.toString(state["row"] + 1) + "/" + util.toString(#state["lines"])
    status = status + "  col " + util.toString(state["col"] + 1)
    rows = array.insert(rows, #rows, ed_frame_row(status, width, true))
    footerText = ""
    if state["mode"] == "exit" {
        footerText = "Save modified buffer?  Y Yes   N No   Esc Cancel"
    } else {
        if state["mode"] == "search" {
            footerText = "Search: " + state["query"]
        } else {
            footerText = "^O Save  ^X Exit  ^W Search  ^K Cut  ^U Paste  ^G Help"
            if #state["message"] > 0 { footerText = state["message"] }
        }
    }
    rows = array.insert(rows, #rows, ed_frame_row(footerText, width, false))
    cursorRow = 1
    cursorCol = 1
    cursorVisible = false
    if state["mode"] == "search" {
        cursorRow = height + 3
        cursorCol = ed_min(width, term.displayWidth(term.sanitize(footerText)) + 1)
        cursorVisible = true
    } else {
        if state["mode"] != "exit" {
            cursorRow = state["row"] - state["top"] + 2
            line = state["lines"][state["row"]]
            cursorText = text.slice(line, state["left"], state["col"])
            cursorCol = term.displayWidth(term.sanitize(cursorText)) + 1
            cursorVisible = true
        }
    }
    return {
        width: width,
        height: height + 3,
        rows: rows,
        cursorRow: cursorRow,
        cursorCol: cursorCol,
        cursorVisible: cursorVisible
    }
}

func ed_style_row(row) {
    if row["inverse"] { return term.inverse(row["text"]) }
    return row["text"]
}

func ed_frame_cursor(frame) {
    if frame["cursorVisible"] {
        return term.cursorTo(frame["cursorRow"], frame["cursorCol"]) + term.showCursor()
    }
    return term.hideCursor()
}

func ed_render_full(frame) {
    screen = term.hideCursor() + term.clear()
    index = 0
    while index < #frame["rows"] {
        screen = screen + ed_style_row(frame["rows"][index])
        if index + 1 < #frame["rows"] { screen = screen + "\r\n" }
        index = index + 1
    }
    return screen + ed_frame_cursor(frame)
}

func ed_row_delta(previous, next, rowNumber) {
    if previous["inverse"] == next["inverse"] and previous["text"] == next["text"] {
        return ""
    }
    if previous["inverse"] != next["inverse"] {
        return term.cursorTo(rowNumber, 1) + ed_style_row(next)
    }
    oldText = previous["text"]
    newText = next["text"]
    start = text.commonPrefixLength(oldText, newText)
    suffix = text.commonSuffixLength(text.slice(oldText, start), text.slice(newText, start))
    oldEnd = #oldText - suffix
    newEnd = #newText - suffix
    oldSuffixColumn = term.displayWidth(term.sanitize(text.slice(oldText, 0, oldEnd)))
    newSuffixColumn = term.displayWidth(term.sanitize(text.slice(newText, 0, newEnd)))
    if oldSuffixColumn != newSuffixColumn { newEnd = #newText }
    column = term.displayWidth(term.sanitize(text.slice(newText, 0, start))) + 1
    replacement = text.slice(newText, start, newEnd)
    if next["inverse"] { replacement = term.inverse(replacement) }
    return term.cursorTo(rowNumber, column) + replacement
}

func ed_render_delta(previous, next) {
    if previous["width"] != next["width"] or previous["height"] != next["height"] {
        return ed_render_full(next)
    }
    changes = ""
    index = 0
    while index < #next["rows"] {
        changes = changes + ed_row_delta(previous["rows"][index], next["rows"][index], index + 1)
        index = index + 1
    }
    cursorChanged = previous["cursorVisible"] != next["cursorVisible"]
    if previous["cursorRow"] != next["cursorRow"] { cursorChanged = true }
    if previous["cursorCol"] != next["cursorCol"] { cursorChanged = true }
    if #changes == 0 and !cursorChanged { return "" }
    return term.hideCursor() + changes + ed_frame_cursor(next)
}

func open(editorPath) {
    editorPath = ed_path(editorPath)
    editorContent = ""
    if file.exists(editorPath) { editorContent = file.read(editorPath) }
    editorState = {
        path: editorPath,
        lines: text.split(editorContent, "\n"),
        row: 0,
        col: 0,
        top: 0,
        left: 0,
        dirty: false,
        running: true,
        mode: "normal",
        query: "",
        clipboard: "",
        message: ""
    }
    editorSize = term.getSize()
    editorWidth = editorSize["width"]
    editorHeight = editorSize["height"]
    io.print(term.alternate(true) + term.mouse(true) + term.paste(true) + term.hideCursor())
    editorFrame = ed_frame(editorState)
    io.print(ed_render_full(editorFrame))
    while editorState["running"] {
        editorEvent = io.readKey(250, true)
        if editorEvent["kind"] == "timeout" {
            nextSize = term.getSize()
            if nextSize["width"] != editorWidth or nextSize["height"] != editorHeight {
                editorWidth = nextSize["width"]
                editorHeight = nextSize["height"]
                nextFrame = ed_frame(editorState)
                editorOutput = ed_render_delta(editorFrame, nextFrame)
                if #editorOutput > 0 { io.print(editorOutput) }
                editorFrame = nextFrame
            }
        } else {
            previousRow = editorState["row"]
            previousTop = editorState["top"]
            previousLeft = editorState["left"]
            previousMode = editorState["mode"]
            editorState = ed_key(editorState, editorEvent)
            if editorState["running"] {
                currentSize = term.getSize()
                fastNormal = previousMode == "normal" and editorState["mode"] == "normal"
                if previousRow != editorState["row"] { fastNormal = false }
                if previousTop != editorState["top"] { fastNormal = false }
                if previousLeft != editorState["left"] { fastNormal = false }
                if currentSize["width"] != editorWidth or currentSize["height"] != editorHeight {
                    fastNormal = false
                }
                if fastNormal {
                    editorChanges = ""
                    nextTitleText = " CilEdit  " + editorState["path"]
                    if editorState["dirty"] { nextTitleText = nextTitleText + "  [Modified]" }
                    nextTitle = ed_frame_row(nextTitleText, editorWidth, true)
                    editorChanges = editorChanges + ed_row_delta(editorFrame["rows"][0], nextTitle, 1)
                    editorFrame["rows"][0] = nextTitle

                    bodyRow = editorState["row"] - editorState["top"] + 2
                    currentLine = editorState["lines"][editorState["row"]]
                    lineStart = ed_min(editorState["left"], #currentLine)
                    nextBody = ed_frame_row(text.slice(currentLine, lineStart), editorWidth, false)
                    editorChanges = editorChanges + ed_row_delta(editorFrame["rows"][bodyRow - 1], nextBody, bodyRow)
                    editorFrame["rows"][bodyRow - 1] = nextBody

                    statusRow = editorFrame["height"] - 1
                    nextStatusText = " line " + util.toString(editorState["row"] + 1) + "/" + util.toString(#editorState["lines"])
                    nextStatusText = nextStatusText + "  col " + util.toString(editorState["col"] + 1)
                    nextStatus = ed_frame_row(nextStatusText, editorWidth, true)
                    editorChanges = editorChanges + ed_row_delta(editorFrame["rows"][statusRow - 1], nextStatus, statusRow)
                    editorFrame["rows"][statusRow - 1] = nextStatus

                    nextFooterText = "^O Save  ^X Exit  ^W Search  ^K Cut  ^U Paste  ^G Help"
                    if #editorState["message"] > 0 { nextFooterText = editorState["message"] }
                    nextFooter = ed_frame_row(nextFooterText, editorWidth, false)
                    editorChanges = editorChanges + ed_row_delta(editorFrame["rows"][editorFrame["height"] - 1], nextFooter, editorFrame["height"])
                    editorFrame["rows"][editorFrame["height"] - 1] = nextFooter

                    cursorText = text.slice(currentLine, editorState["left"], editorState["col"])
                    nextCursorRow = bodyRow
                    nextCursorCol = term.displayWidth(term.sanitize(cursorText)) + 1
                    cursorChanged = editorFrame["cursorVisible"] == false
                    if editorFrame["cursorRow"] != nextCursorRow { cursorChanged = true }
                    if editorFrame["cursorCol"] != nextCursorCol { cursorChanged = true }
                    editorFrame["cursorVisible"] = true
                    editorFrame["cursorRow"] = nextCursorRow
                    editorFrame["cursorCol"] = nextCursorCol
                    editorOutput = ""
                    if #editorChanges > 0 or cursorChanged {
                        editorOutput = term.hideCursor() + editorChanges + ed_frame_cursor(editorFrame)
                    }
                    if #editorOutput > 0 { io.print(editorOutput) }
                } else {
                    nextFrame = ed_frame(editorState)
                    editorOutput = ed_render_delta(editorFrame, nextFrame)
                    if #editorOutput > 0 { io.print(editorOutput) }
                    editorFrame = nextFrame
                    editorWidth = nextFrame["width"]
                    editorHeight = nextFrame["height"]
                }
            }
        }
    }
    io.print(term.alternate(false) + term.mouse(false) + term.paste(false) + term.showCursor())
    return null
}

// Universal zero-argument application entrypoint used by package.run("<editor-db-sha256>").
func run() {
    return open("untitled.txt")
}
