# Install as /etc/cilexec/cilexec.env with root:root ownership and mode 0600.
CILEXEC_INSTANCE_NAME=cilexec-production
CILEXEC_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/cilexec
CILEXEC_DATABASE_SSL_ROOT_CERTIFICATE_FILE=/etc/cilexec/postgres-ca.crt
CILEXEC_DATABASE_CONNECTION_TIMEOUT=PT10S
CILEXEC_DATABASE_VALIDATION_TIMEOUT=PT5S
CILEXEC_DATABASE_STATEMENT_TIMEOUT=PT30S
CILEXEC_MIGRATE_ON_START=false

CILEXEC_RUNTIME_DATABASE_USER=cilexec_runtime
CILEXEC_RUNTIME_DATABASE_PASSWORD_FILE=/etc/cilexec/secrets/cilexec_runtime_password
CILEXEC_RUNTIME_POOL_MAX=20
CILEXEC_RUNTIME_POOL_MIN_IDLE=2

CILEXEC_EFFECT_DATABASE_USER=cilexec_effect_worker
CILEXEC_EFFECT_DATABASE_PASSWORD_FILE=/etc/cilexec/secrets/cilexec_effect_worker_password
CILEXEC_EFFECT_POOL_MAX=6
CILEXEC_EFFECT_POOL_MIN_IDLE=1

CILEXEC_MIGRATOR_DATABASE_USER=cilexec_migrator
CILEXEC_MIGRATOR_DATABASE_PASSWORD_FILE=/etc/cilexec/secrets/cilexec_migrator_password
CILEXEC_MIGRATOR_POOL_MAX=2
CILEXEC_MIGRATOR_POOL_MIN_IDLE=0

CILEXEC_EXPORTER_DATABASE_USER=cilexec_exporter
CILEXEC_EXPORTER_DATABASE_PASSWORD_FILE=/etc/cilexec/secrets/cilexec_exporter_password
CILEXEC_EXPORTER_POOL_MAX=1
CILEXEC_EXPORTER_POOL_MIN_IDLE=0

CILEXEC_SCHEDULER_WORKERS=10
CILEXEC_LEASE_DURATION=PT30S
CILEXEC_SCHEDULER_ERROR_BACKOFF=PT0.025S
CILEXEC_EFFECT_WORKERS=6
CILEXEC_EFFECT_ERROR_BACKOFF=PT0.025S
CILEXEC_SHUTDOWN_GRACE=PT30S
CILEXEC_HEALTH_DATABASE_PROBE_INTERVAL=PT10S
CILEXEC_HEALTH_PORT=8080
CILEXEC_LOG_LEVEL=INFO
