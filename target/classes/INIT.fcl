# INIT Process - System initialization

# Create log file first
createFile("/user/local", "hello.log")

int counter = 0

while true {
    # Sleep 500ms
    sleep(500)
    
    # Increment counter
    counter = counter + 1
    
    # Append HELLO_WORLD line to file
    append("/user/local/hello.log", "HELLO_WORLD")
}
