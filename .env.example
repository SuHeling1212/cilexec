# Copy to .env for an online production deployment. Formal release archives provide a .env
# whose CILEXEC_IMAGE value is pinned to the signed multi-architecture manifest digest.
CILEXEC_IMAGE=ghcr.io/suheling1212/cilexec@sha256:replace-with-release-manifest-digest
CILEXEC_DATABASE_NAME=cilexec
CILEXEC_INSTANCE_NAME=cilexec-production
# Install.sh records CILEXEC_CONTAINER_UID/GID for the account that owns docker/secrets.
# Set positive numeric IDs explicitly only when another account owns that directory.
CILEXEC_RUNTIME_MEMORY_LIMIT=2048m
CILEXEC_POSTGRES_MEMORY_LIMIT=1g
CILEXEC_RUNTIME_CPUS=2.0
CILEXEC_POSTGRES_CPUS=2.0

# Private-network HTTP and host command effects are denied unless explicitly configured.
CILEXEC_NETWORK_ALLOW_PRIVATE_HTTP_ORIGINS=
CILEXEC_FCL_EXEC_ALLOWLIST=
